# ── Safety ───────────────────────────────────────────────────────────────
# Nothing is sent on-chain unless LIVE=true. Leave it unset for a dry-run week:
# the bot reads the chain, snapshots holders and logs every payout it WOULD make.
LIVE=

# ── Network ──────────────────────────────────────────────────────────────
# A dedicated RPC (Helius/Triton/QuickNode): the public endpoint rejects the
# getProgramAccounts holder scan. SOLANA_RPC_URL is accepted as an alias.
RPC_URL=https://api.devnet.solana.com

# ── Token ────────────────────────────────────────────────────────────────
MINT_ADDRESS=

# ── Wallets ──────────────────────────────────────────────────────────────
# Each wallet is EITHER the secret itself (JSON byte array or base58; use a
# Railway sealed variable) OR <NAME>_PATH pointing at a keypair file.
# Never commit either.
#
# The pump.fun creator wallet: claims creator fees, splits them into the vaults.
# It MUST be the wallet that created the coin (creator vaults are keyed by it).
FEE_AUTHORITY_KEYPAIR=
FEE_AUTHORITY_KEYPAIR_PATH=./keys/fee-authority.json
# Receives the LP share and signs Raydium add-liquidity transactions.
LP_VAULT_KEYPAIR=
LP_VAULT_KEYPAIR_PATH=./keys/lp-vault.json
# Receives the holder share and pays every airdrop.
REWARDS_VAULT_KEYPAIR=
REWARDS_VAULT_KEYPAIR_PATH=./keys/rewards-vault.json

# ── Tokenomics ───────────────────────────────────────────────────────────
# Fraction (0-1) of each harvest routed to the LP vault; the rest funds holder rewards.
LP_SHARE=0.5
# Cycle length in ms. 900000 = 15 min. Minimum 60000.
SNAPSHOT_INTERVAL_MS=900000
# Extra wallets to exclude (CEX deposit wallets, team, ...). The three protocol
# wallets and every PDA owner (bonding curve, pools) are always excluded.
EXCLUDED_OWNERS=
# Minimum raw base-unit balance to be eligible (filters dust).
MIN_ELIGIBLE_BALANCE=1

# ── Raydium auto-LP ──────────────────────────────────────────────────────
# CPMM pool id. Unset = the LP share accumulates in the LP vault.
RAYDIUM_POOL_ID=

# ── Stats + payout-plan storage ──────────────────────────────────────────
# Supabase (preferred: the Vercel site reads the same table). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Without Supabase: JSON docs under DATA_DIR/store (mount a Railway volume at /data).
DATA_DIR=./data

# ── Stats API ────────────────────────────────────────────────────────────
# Railway sets PORT; API_PORT is the local fallback.
API_PORT=4000
