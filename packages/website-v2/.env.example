# ── Public (safe in the browser) ─────────────────────────────────────────────
# The $ARROW mint. Empty = "contract address appears at launch".
NEXT_PUBLIC_MINT_ADDRESS=
NEXT_PUBLIC_SITE_URL=https://sherwood.example

# ── Server-only (Vercel env vars, NEVER prefix with NEXT_PUBLIC_) ────────────
# Preferred: read stats straight from Supabase (same project the bot writes to).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Fallback: the bot's own stats API on Railway (e.g. https://sherwood-bot.up.railway.app)
BOT_API_URL=
